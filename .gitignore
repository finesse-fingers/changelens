node_modules
dist

# Local run state. The app's own database lives in ~/.changelens, but a
# contributor pointing it somewhere else should not be able to commit one:
# a Changelens database holds diffs and review notes from real repositories.
*.sqlite
*.db

# Never committed, and there is no .env.example inviting it — nothing in this
# repo loads a .env file. Listed because the mistake is cheap to make.
.env
.env.*.local

*.log
.DS_Store
Thumbs.db

# Claude Code writes per-machine permissions here; launch.json is shared.
.claude/settings.local.json

.vscode/
.idea/
*.swp
