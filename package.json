{
  "name": "changelens",
  "version": "0.1.0",
  "description": "An interactive review console over the Claude Code CLI — see what an agent-written diff actually changes, judged and annotated beside the code.",
  "license": "MIT",
  "author": "Bobby Koteski",
  "homepage": "https://github.com/finesse-fingers/changelens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finesse-fingers/changelens.git"
  },
  "bugs": {
    "url": "https://github.com/finesse-fingers/changelens/issues"
  },
  "keywords": [
    "code-review",
    "diff",
    "claude",
    "claude-code",
    "ai",
    "pull-request",
    "git",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && pnpm build:assets",
    "build:assets": "node scripts/copy-server-assets.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "check:auth": "tsx scripts/auth-proof.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3",
    "shiki": "^2.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "@tailwindcss/vite": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
